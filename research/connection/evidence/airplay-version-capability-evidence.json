  "findings": [
    {
      "id": "AVC-01",
      "priority": "P1_COVERAGE",
      "claim": "At the reviewed AirSession connection path, formal mode or a missing shared secret unconditionally enters requireSapSignatureSchema(), which always throws; authentication/SETUP cannot continue beyond that point.",
      "sources": [
        "AVC-A03:487-491",
        "AVC-A05:112-124"
      ],
      "limits": "Intentional fail-closed execution boundary, not authorization to bypass trust; no deployed-APK claim."
    },
    {
      "id": "AVC-02",
      "priority": "P1_RESEARCH",
      "claim": "4301 srcVer/sdkVer are not consumed by wifiConfig; mutualAuth is only logged and not retained in WifiBootstrap/security inputs. Discovery metadata has no featuresEx/noPair/mutualAuth slot.",
      "sources": [
        "AVC-A07:18-52,875-913",
        "AVC-A02:18-24,116-117",
        "AVC-A04:11-31"
      ],
      "limits": "4301 field names/types reference chapter 21; noPair is an internal selection outcome in the reviewed Apple evidence, not established as a required TXT key. Raw callback exists, but no production consumer was found by repository Kotlin reference search."
    },
    {
      "id": "AVC-03",
      "priority": "P2_DIAGNOSTIC",
      "claim": "AirPlayGenerations labels any non-null protocolVersion V1 absent earlier signals; service clues and feature bit46 can label V2 although actual route does not use these signals.",
      "sources": [
        "AVC-A01:100-133",
        "AVC-A03:430-443",
        "AVC-A05:47-64"
      ],
      "limits": "Generation is diagnostic only in the audited production source; not shown to change the selected authentication route."
    },
    {
      "id": "AVC-04",
      "priority": "P2_DIAGNOSTIC",
      "claim": "Clue service types are aggregated without endpoint/peer matching then attached to the selected receiver metadata.",
      "sources": [
        "AVC-A02:34-36,60-75,116-117"
      ],
      "limits": "Can contaminate generation logs; not evidence of authentication bypass or route change."
    },
    {
      "id": "AVC-05",
      "priority": "P2_DIAGNOSTIC",
      "claim": "INFO protocol/source/features are read after SETUP and used for generation logs; '/info wins from here' does not update version metadata or reselect security routing.",
      "sources": [
        "AVC-A03:517-556"
      ],
      "limits": "Other INFO fields such as audioFormats/displays do have consumers and are outside this version-only statement."
    },
    {
      "id": "AVC-06",
      "priority": "P2_SCHEMA",
      "claim": "TXT features parser treats unprefixed values as hexadecimal despite a comment promising decimal support; decimal interoperability is not established by this audit.",
      "sources": [
        "AVC-A01:76-77",
        "AVC-A08:23-31"
      ],
      "example": {
        "input": "4294967296",
        "if_decimal": "0x100000000",
        "actual_parser_hex": "0x4294967296",
        "if_decimal_bit38": false,
        "actual_parser_bit38": true
      },
      "limits": "Arithmetic illustration from source, not a Kotlin test or captured target TXT."
    },
    {
      "id": "AVC-07",
      "priority": "P2_DECLARATION",
      "claim": "Local sourceVersion 320.17, User-Agent and compatibility OS build 21A329 are a local compatibility combination, not the 24A446 source identity.",
      "sources": [
        "AVC-A06:1-19",
        "AVC-A03:493-498,982",
        "AVC-F04"
      ],
      "limits": "Changing the literal alone does not add protocol behavior; truthful Android model/osName/osVersion remain separately reported."
    }
  ],
