        "0x24fda633c-0x24fda6380",
        "AirSession.kt:230-232,517-528,659",
        "Rtsp.kt:161-162,198-199"
      ]
    },
    {
      "id": "VH-02",
      "status": "CLOSED-STATIC",
      "claim": "Provider at 0x226ed0894 loads the initialized u32 UserVersion slot. Unsigned values <3 are returned unchanged (0/1/2), all other u32 values map to 1. An initialization block calls a reader with UserVersion, com.apple.airplay and w2=-1 then stores w0. The reader implementation and actual preferences were not audited; do not declare a universal on-wire literal or infer this is iOS major version.",
      "anchors": [
        "0x226ed08b8-0x226ed08c4",
        "0x226ed0950-0x226ed0980"
      ]
    },
    {
